    "friction": {
      "basis": "1/2 S_entry + 1/2 S_exit from the OBSERVED quoted spread prevailing at the entry instant and at the exit instant, expressed in bps of the entry midpoint, evaluated by M2/src/envelope.py::midpoint_markout_friction_bps",
